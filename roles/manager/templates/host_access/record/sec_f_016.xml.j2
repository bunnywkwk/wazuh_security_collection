<!-- {{ ansible_managed }} -->
<!-- SEC-F-016 RECORD: login on the physical or serial console (PAM service "login") -->
<group name="host_access,">
  <rule id="100123" level="5">
    <if_sid>5501</if_sid>
    <match>(login:session)</match>
    <description>SEC-F-016: console or serial login by $(dstuser).</description>
    <group>sec_f_016,pam,authentication_success,</group>
  </rule>
</group>
