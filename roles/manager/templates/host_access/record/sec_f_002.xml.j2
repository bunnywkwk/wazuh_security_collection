<!-- {{ ansible_managed }} -->
<!-- SEC-F-002 RECORD: failed SSH logins -->
<group name="host_access,">
  <!-- Existing account. The SEC-TH-001 to 005 thresholds count this rule. -->
  <rule id="100111" level="5">
    <if_sid>5760</if_sid>
    <description>SEC-F-002: failed login for $(dstuser) from $(srcip).</description>
    <group>sec_f_002,sshd,authentication_failed,</group>
  </rule>

  <!-- Account that does not exist on the host (sshd says "invalid user"). Recorded, not counted.
       Only the "Failed ..." line: sshd also writes an "Invalid user" line for the same attempt. -->
  <rule id="100124" level="5">
    <if_sid>5710</if_sid>
    <match type="pcre2">^Failed \S+ for invalid user</match>
    <description>SEC-F-002: failed login for unknown account $(dstuser) from $(srcip).</description>
    <group>sec_f_002,sshd,authentication_failed,invalid_login,</group>
  </rule>
</group>
