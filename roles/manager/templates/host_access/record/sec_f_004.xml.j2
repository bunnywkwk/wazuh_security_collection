<!-- {{ ansible_managed }} -->
<!-- SEC-F-004 RECORD: SSH or console session closed (sudo and su sessions left out) -->
<group name="host_access,">
  <rule id="100122" level="3">
    <if_sid>5502</if_sid>
    <match type="pcre2">\((sshd|login):session\)</match>
    <description>SEC-F-004: session closed for $(dstuser).</description>
    <group>sec_f_004,pam,</group>
  </rule>
</group>
