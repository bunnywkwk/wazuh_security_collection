<!-- {{ ansible_managed }} -->
<!-- SEC-TH-001 THRESHOLD (SEC-F-003): service accounts, CDB list etc/lists/service-accounts -->
<group name="host_access,">
  <rule id="100112" level="8" frequency="{{ manager_th_001_warning }}" timeframe="{{ manager_th_001_timeframe }}">
    <if_matched_sid>100111</if_matched_sid>
    <list field="dstuser" lookup="match_key">etc/lists/service-accounts</list>
    <same_user />
    <description>SEC-TH-001 WARNING: service account $(dstuser) failed login {{ manager_th_001_warning }} times in {{ manager_th_001_timeframe // 60 }} minutes.</description>
    <mitre><id>T1110.001</id></mitre>
    <group>sec_f_003,sec_th_001,</group>
  </rule>

  <rule id="100113" level="12" frequency="{{ manager_th_001_critical }}" timeframe="{{ manager_th_001_timeframe }}">
    <if_matched_sid>100111</if_matched_sid>
    <list field="dstuser" lookup="match_key">etc/lists/service-accounts</list>
    <same_user />
    <description>SEC-TH-001 CRITICAL: service account $(dstuser) failed login {{ manager_th_001_critical }} times in {{ manager_th_001_timeframe // 60 }} minutes.</description>
    <mitre><id>T1110.001</id></mitre>
    <group>sec_f_003,sec_th_001,</group>
  </rule>
</group>
