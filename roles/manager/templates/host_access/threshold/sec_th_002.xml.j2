<!-- {{ ansible_managed }} -->
<!-- SEC-TH-002: failed logins, one standard account from one source (list standard-accounts) -->
<group name="host_access,">
  <!-- counts built-in 5760: failed password, existing account -->
  <rule id="100114" level="8" frequency="{{ manager_standard_account_warning }}" timeframe="{{ manager_standard_account_timeframe }}">
    <if_matched_sid>5760</if_matched_sid>
    <list field="user" lookup="match_key">etc/lists/standard-accounts</list>
    <same_user />
    <same_srcip />
    <description>SEC-TH-002 WARNING: $(dstuser) failed login {{ manager_standard_account_warning }} times in {{ manager_standard_account_timeframe // 60 }} minutes from $(srcip).</description>
    <mitre><id>T1110.001</id></mitre>
    <group>sec_f_003,sec_th_002,</group>
  </rule>

  <rule id="100115" level="12" frequency="{{ manager_standard_account_critical }}" timeframe="{{ manager_standard_account_timeframe }}">
    <if_matched_sid>5760</if_matched_sid>
    <list field="user" lookup="match_key">etc/lists/standard-accounts</list>
    <same_user />
    <same_srcip />
    <description>SEC-TH-002 CRITICAL: $(dstuser) failed login {{ manager_standard_account_critical }} times in {{ manager_standard_account_timeframe // 60 }} minutes from $(srcip).</description>
    <mitre><id>T1110.001</id></mitre>
    <group>sec_f_003,sec_th_002,</group>
  </rule>
</group>
