<!-- {{ ansible_managed }} -->
<!-- SEC-F-018 RECORD: failed sudo or su (wrong password, not in sudoers, command not allowed).
     SEC-TH-007 (sec_th_007.xml) counts 100100. 100107 and 100109 are helpers, never the alert. -->
<group name="privileged_activity,">
  <!-- sudo refused wherever it lands: the sudo parent 5400 or a success rule (5402, 5403, 5407),
       since its line also has "USER=root ; COMMAND=" -->
  <rule id="100107" level="5">
    <if_sid>5400, 5402, 5403, 5407</if_sid>
    <match>command not allowed|user NOT in sudoers|incorrect password attempt</match>
    <description>SEC-F-018: sudo refused for $(srcuser).</description>
    <group>sec_f_018,</group>
  </rule>

  <!-- su failed: the PAM auth failure line (5503) decodes the account (srcuser = ruser).
       The "FAILED SU" line of the same attempt has no account and is not counted. -->
  <rule id="100109" level="5">
    <if_sid>5503</if_sid>
    <match type="pcre2">pam_unix\(su(-l)?:auth\): authentication failure</match>
    <description>SEC-F-018: su failed for $(srcuser).</description>
    <group>sec_f_018,</group>
  </rule>

  <!-- built-in sudo failures: 5401 / 5404 wrong password, 5405 not in sudoers, 5406 command not allowed -->
  <rule id="100100" level="5">
    <if_sid>5401, 5404, 5405, 5406, 100107, 100109</if_sid>
    <description>SEC-F-018: failed privilege elevation by $(srcuser).</description>
    <group>sec_f_018,</group>
  </rule>
</group>
