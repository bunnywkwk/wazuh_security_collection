<!-- {{ ansible_managed }} -->
<!-- SEC-F-018: one rule for every failed sudo and su, because SEC-TH-007 can count only one rule -->
<group name="privileged_activity,">
  <!-- su failure from its PAM line (5503), the one that names the account -->
  <rule id="100109" level="5">
    <if_sid>5503</if_sid>
    <match type="pcre2">pam_unix\(su(-l)?:auth\): authentication failure</match>
    <description>SEC-F-018: su failed for $(srcuser).</description>
    <group>sec_f_018,</group>
  </rule>

  <!-- sudo: 5401 / 5404 wrong password, 5405 not in sudoers, 5406 command not allowed -->
  <rule id="100100" level="5">
    <if_sid>5401, 5404, 5405, 5406, 100109</if_sid>
    <description>SEC-F-018: failed privilege elevation by $(srcuser).</description>
    <group>sec_f_018,</group>
  </rule>
</group>
