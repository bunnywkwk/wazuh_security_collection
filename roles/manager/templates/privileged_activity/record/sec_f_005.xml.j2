<!-- {{ ansible_managed }} -->
<!-- SEC-F-005 RECORD: sudo or su worked. The alert keeps who (srcuser), as whom (dstuser) and, for sudo, the command. -->
<group name="privileged_activity,">
  <!-- sudo worked: built-in 5402 to root, 5403 first time, 5407 to another user -->
  <rule id="100104" level="3">
    <if_sid>5402, 5403, 5407</if_sid>
    <!-- a refused sudo also has "USER=root ; COMMAND=": it is SEC-F-018, not a success -->
    <match negate="yes">command not allowed|user NOT in sudoers|incorrect password attempt</match>
    <description>SEC-F-005: $(srcuser) elevated to $(dstuser) with sudo.</description>
    <group>sec_f_005,</group>
  </rule>

  <!-- su worked: RHEL 9's "(to <user>) <who> on" line gets no built-in rule; its PAM session line does (5501) -->
  <rule id="100108" level="3">
    <if_sid>5501</if_sid>
    <match type="pcre2">pam_unix\(su(-l)?:session\): session opened</match>
    <description>SEC-F-005: $(srcuser) switched to $(dstuser) with su.</description>
    <group>sec_f_005,</group>
  </rule>
</group>
