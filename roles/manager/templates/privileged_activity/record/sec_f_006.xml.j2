<!-- {{ ansible_managed }} -->
<!-- SEC-F-006 RECORD: an admin command from the agent's audit rule (key {{ manager_sec_f_006_key }}) -->
<group name="privileged_activity,">
  <rule id="100105" level="3">
    <if_sid>{{ manager_sec_f_006_sid }}</if_sid>
    <field name="audit.key">^{{ manager_sec_f_006_key }}$</field>
    <description>SEC-F-006: admin command $(audit.exe) run as root by login uid $(audit.auid).</description>
    <group>sec_f_006,audit_command,</group>
  </rule>
</group>
