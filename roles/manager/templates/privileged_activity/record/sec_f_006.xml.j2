<!-- {{ ansible_managed }} -->
<!-- SEC-F-006 RECORD: an admin command from the agent's audit rule. Key audit-wazuh-c is Wazuh's own
     label for "command" (etc/lists/audit-keys); the agent role uses the same key. -->
<group name="privileged_activity,">
  <rule id="100105" level="3">
    <if_sid>80792</if_sid>
    <field name="audit.key">^audit-wazuh-c$</field>
    <description>SEC-F-006: admin command $(audit.exe) run as root by login uid $(audit.auid).</description>
    <group>sec_f_006,audit_command,</group>
  </rule>
</group>
